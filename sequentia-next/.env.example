# Copy to .env for local development. Never commit the real .env.

# Core
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Database (leave unset to use local SQLite)
DATABASE_URL=

# Email (password reset). Defaults to printing emails to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sequentia <no-reply@sequentia.local>
